{
  "name": "obsidian-adaptive-workspace",
  "version": "0.1.0",
  "description": "Automatically adapt your Obsidian workspace based on display, window, and environment.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "lint": "eslint src test",
    "lint:styles": "stylelint styles.css",
    "verify": "npm run typecheck && npm run lint && npm run lint:styles && npm run test && npm run build",
    "sync": "node scripts/sync-to-vault.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "automation",
    "workspace",
    "multi-monitor"
  ],
  "author": "liyifan2004",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@obsidian-typings/obsidian-public-latest": "latest",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "stylelint": "^17.16.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
